#!/usr/bin/env bash
#MISE description="Edit the encrypted deploy credentials (.deploy.secrets.enc) in place"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
# shellcheck source=/dev/null
source "$root/mise-tasks/lib/env.sh"

command -v sops >/dev/null || die "sops not found (brew install sops)"
[[ -f .sops.yaml ]] || die ".sops.yaml not found; is this the notify checkout?"
if grep -q "REPLACE_WITH" .sops.yaml; then
    die ".sops.yaml still holds the placeholder recipient; put the mail age public key in it first"
fi

if [[ ! -f .deploy.secrets.enc ]]; then
    # First run: sops cannot open a file that does not exist, so write the two
    # names to edit, then encrypt whatever the editor leaves behind.
    note "no .deploy.secrets.enc yet; writing a template to edit"
    cat > .deploy.secrets <<'EOF'
# The Fastmail account's login address: the row marked "Username" in
# Settings -> My email addresses. Not feedback@marending.dev, which is an alias
# and cannot authenticate (Fastmail answers 535).
SMTP_USER=
# An app password for that account, scoped to SMTP only.
SMTP_PASSWORD=
# Written by Acta as `Authorization: Bearer ...`. Generate one with:
#   openssl rand -hex 32
ALERT_TOKEN=
EOF
    "${EDITOR:-vi}" .deploy.secrets
    SOPS_AGE_KEY="$(age_key)" sops --encrypt --input-type dotenv --output-type dotenv .deploy.secrets > .deploy.secrets.enc \
        || { rm -f .deploy.secrets; die "sops failed to encrypt .deploy.secrets"; }
    rm -f .deploy.secrets
else
    # sops decrypts to a temp file, opens $EDITOR on it and re-encrypts on save,
    # so a plaintext copy does not stay in the repo. The age key is passed to
    # that one command instead of being exported. Quitting the editor without
    # saving leaves the ciphertext untouched.
    note "editing .deploy.secrets.enc"
    SOPS_AGE_KEY="$(age_key)" sops --input-type dotenv --output-type dotenv .deploy.secrets.enc
fi

note "installing the values: mise run deploy:secrets"
