#!/usr/bin/env bash
#MISE description="Create/replace the podman secrets (Fastmail app password, alert token)"
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
cd "$root"
# shellcheck source=/dev/null
source "$root/mise-tasks/lib/env.sh"

# The age key is fetched from 1Password here and nowhere else. `mise run deploy`
# never decrypts anything; it only checks that these secrets exist.
load_deploy_secrets

host="${NOTIFY_HOST:-eos}"

create() {
    local name="$1" var="$2" value="${3:-}"
    [[ -n "$value" ]] || die "$var is empty; add it to the secrets file, re-encrypt it, and re-run"
    # The value travels on stdin, so it never appears in the remote argv.
    printf '%s' "$value" | ssh "$host" "podman secret create --replace $name - >/dev/null"
    echo "  ${name}"
}

note "installing podman secrets on ${host}"
# A Fastmail app password scoped to SMTP only. Fastmail authenticates the full
# address, not the local part, which is why SMTP_USER in src/config.rs is
# feedback@marending.dev.
create notify-smtp-password SMTP_PASSWORD "${SMTP_PASSWORD:-}"
# Written by Acta, verified by notify. One token, one route: it does not open
# /feedback.
create notify-alert-token ALERT_TOKEN "${ALERT_TOKEN:-}"

# A running container keeps the environment it started with, so a rotated
# secret only takes effect after a restart. Skip silently before the first
# deploy, when the unit does not exist yet.
if ssh "$host" 'systemctl --user cat notify >/dev/null 2>&1'; then
    note "restarting notify so the new secrets take effect"
    ssh "$host" 'systemctl --user restart notify'
else
    note "notify is not installed yet; run: mise run deploy"
fi
